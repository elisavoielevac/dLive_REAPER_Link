{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dLive REAPER Link",
  "version": "0.2.0-beta.2",
  "identifier": "com.elisavoielevac.dlive-reaper-link",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "dLive REAPER Link",
        "width": 420,
        "height": 260,
        "minWidth": 320,
        "minHeight": 220
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
