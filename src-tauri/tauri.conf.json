{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dLive REAPER Link",
  "version": "0.3.0-beta.1",
  "identifier": "com.elisavoielevac.dlive-reaper-link",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "dLive REAPER Link \u2014 Settings",
        "url": "index.html",
        "width": 760,
        "height": 640,
        "minWidth": 600,
        "minHeight": 460,
        "visible": false
      },
      {
        "label": "live",
        "title": "dLive REAPER Link \u2014 Live",
        "url": "index.html?view=live",
        "width": 420,
        "height": 250,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
